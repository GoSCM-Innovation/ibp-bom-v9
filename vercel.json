{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/cron-tick", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/api/connections/:id", "destination": "/api/connections" },
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
