# ─── Upstash Redis (Vercel KV integration) ──────────────────────────────────
# Usado por api/orchestrate.js, api/orchestrations.js, api/connections.js,
# api/cron-tick.js para persistir conexiones, definiciones y estado de ejecuciones.
KV_REST_API_URL=https://<your-upstash-instance>.upstash.io
KV_REST_API_TOKEN=<your-upstash-rest-token>

# ─── API auth (REQUERIDO) ───────────────────────────────────────────────────
# Token compartido entre frontend (VITE_API_TOKEN) y backend (API_TOKEN).
# Cualquier request a /api/* sin este header `Authorization: Bearer ${API_TOKEN}`
# es rechazado con 401. Mínimo 16 chars. Si falta, los endpoints responden 500.
API_TOKEN=<genera-un-token-aleatorio-de-32-bytes-hex>

# ─── CORS allowlist (REQUERIDO en producción) ───────────────────────────────
# Lista separada por comas de orígenes permitidos. Si está vacía, ningún sitio
# externo puede hacer requests con credenciales (los requests same-origin
# desde el propio dominio del deployment siguen funcionando).
# Dev típico: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ─── Cron auth (REQUERIDO si usás /api/cron-tick) ───────────────────────────
# Vercel Cron envía `Authorization: Bearer ${CRON_SECRET}`. Mínimo 16 chars.
# Si falta, el endpoint responde 500 (fail-secure).
CRON_SECRET=<genera-otro-token-aleatorio>

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# Mismo valor que API_TOKEN. Vite expone variables con prefijo VITE_ al cliente.
# Considerar: si tu modelo de amenaza incluye usuarios no confiables con acceso
# al frontend, este token es público de facto. Mover a auth por sesión.
VITE_API_TOKEN=<mismo-valor-que-API_TOKEN>
